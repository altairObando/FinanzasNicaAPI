# Copia este archivo como .env y completa los valores reales.
# .env nunca debe subirse al repositorio.

# Django
DEBUG=False
SECRET_KEY=cambia-esta-clave-por-una-segura
# Hosts permitidos, separados por coma (sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes confiables para CSRF, separados por coma, con esquema
TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Base de datos (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
